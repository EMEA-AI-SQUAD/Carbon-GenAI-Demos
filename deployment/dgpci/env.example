# DGPCI Demo — Environment Variables
# Copy to .env before running podman-compose
# ------------------------------------------------------------------------------

# PostgreSQL
POSTGRES_USER=dgpci
POSTGRES_PASSWORD=dgpci_secret
POSTGRES_DB=dgpci

# Ollama model — pulled during deploy
# granite4.2:8b  — latest IBM Granite (5.3 GB, 128K context, Chinese + multilingual)
# granite4.2:3b  — lighter option (2.2 GB) if RAM is tight
# granite4.1:8b  — previous generation, well-tested on Power
OLLAMA_MODEL=granite4.2:8b

# Ollama ppc64le image
OLLAMA_IMAGE=icr.io/ppc64le-oss/ollama-ppc64le:v0.17.6

# Optional: override pre-built image names if you push to a registry
# EXTRACT_IMAGE=localhost/dgpci-extract:latest
# TRANSLATE_IMAGE=localhost/dgpci-translate:latest
# RAG_BACKEND_IMAGE=localhost/dgpci-rag-backend:latest
# CARBON_UI_IMAGE=localhost/dgpci-carbon-ui:latest
