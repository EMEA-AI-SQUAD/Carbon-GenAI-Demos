# TechXChange Lab 1127 — environment variable reference
# Copy to .env.local for local development

# ── LLM backends ──────────────────────────────────────────────────────────────
# CPU path — llama.cpp or any OpenAI-compatible endpoint
LLAMA_URL=http://localhost:8080

# IBM Spyre path — vLLM running on Spyre cards (vllm-spyre-rhel9 image).
# Inspect the running pod to find the internal port:
#   podman inspect llm-aa67fe1b75-llm --format '{{json .NetworkSettings}}'
#   podman port --all
# vLLM default port is 8000. The 146 server is the Spyre host.
SPYRE_URL=http://9.8.70.146:8001

# ── Next.js ───────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# ── Proxy server ─────────────────────────────────────────────────────────────
# (used by server_final.js — not needed for the /api/chat route)
PROXY_PORT=3001
PASSPORTEYE_URL=http://localhost:5000
