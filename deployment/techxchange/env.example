# TechXChange Lab 1127 — environment variable reference
# Copy to .env.local for local development

# ── LLM backends ──────────────────────────────────────────────────────────────
# Local llama.cpp (IBM Power MMA path)
LLAMA_URL=http://localhost:8080

# IBM Spyre hardware accelerator (faster inference)
# The Spyre cards are on a separate host; this endpoint must be reachable
# from the LPAR running the Next.js app.
SPYRE_URL=http://9.8.70.146:8080

# ── Next.js ───────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# ── Proxy server ─────────────────────────────────────────────────────────────
# (used by server_final.js — not needed for the /api/chat route)
PROXY_PORT=3001
PASSPORTEYE_URL=http://localhost:5000
