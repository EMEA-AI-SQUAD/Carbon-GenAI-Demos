# Ensure shell scripts always have LF line endings regardless of OS
*.sh        text eol=lf
*.py        text eol=lf
*.js        text eol=lf
*.ts        text eol=lf
*.json      text eol=lf
*.md        text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf
*.scss      text eol=lf
*.css       text eol=lf

# Binary files — no line ending conversion
*.pem       binary
*.pptx      binary
*.png       binary
*.jpg       binary
*.ico       binary
